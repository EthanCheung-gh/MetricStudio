      "replay": [
        "{\"tools\": [{\"name\": \"filter_stats\", \"args\": {\"conditions\": [{\"column\": \"region\", \"operator\": \"eq\", \"value\": \"North\"}, {\"column\": \"amount\", \"operator\": \"gt\", \"value\": 300}], \"agg\": \"count\"}}]}",
        "{\"answer\": \"North 区域 amount 大于 300 的记录有 **2** 条 [1]。\", \"followups\": [], \"clarify\": null}"
      ]
