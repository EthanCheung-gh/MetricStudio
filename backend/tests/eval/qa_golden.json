{
  "description": "MetricStudio QA golden set (v1.11.0). Fixtures are deterministic (see fixtures.py); 'replay' rounds are canned LLM replies so --mode replay exercises the real loop/tools/citations with zero network. expect.assertions apply to both replay and live runs.",
  "cases": [
    {
      "id": "sales-row-count",
      "fixture": "sales",
      "question": "这个数据集有多少行？",
      "expect": {
        "tools_required": ["row_count"],
        "facts_contain": [{"tool": "row_count", "pattern": "row_count = 24"}],
        "must_cite": true,
        "answer_contains": ["24"]
      },
      "replay": [
        "{\"tools\": [{\"name\": \"row_count\", \"args\": {}}]}",
        "{\"answer\": \"该数据集共有 **24** 行 [1]。\", \"followups\": [\"按地区统计行数？\"], \"clarify\": null}"
      ]
    },
    {
      "id": "sales-region-amount-sum",
      "fixture": "sales",
      "question": "每个地区的 amount 总和是多少，按从高到低排？",
      "expect": {
        "tools_required": ["groupby_agg"],
        "facts_contain": [{"tool": "groupby_agg", "pattern": "South=1,542"}],
        "must_cite": true,
        "answer_contains": ["1542"]
      },
      "replay": [
        "{\"tools\": [{\"name\": \"groupby_agg\", \"args\": {\"column\": \"region\", \"agg_column\": \"amount\", \"agg\": \"sum\", \"top_n\": 5, \"sort\": \"desc\"}}]}",
        "{\"answer\": \"各地区 amount 总和（降序）：South **1542** [1]、East 1364、North 1320、West 1186。\", \"followups\": [], \"clarify\": null}"
      ]
    },
    {
      "id": "sales-qty-mean",
      "fixture": "sales",
      "question": "qty 列的平均值是多少？",
      "expect": {
        "tools_required": ["column_stats"],
        "facts_contain": [{"tool": "column_stats", "pattern": "mean=2.9167"}],
        "must_cite": true,
        "answer_contains": ["2.9167"]
      },
      "replay": [
        "{\"tools\": [{\"name\": \"column_stats\", \"args\": {\"column\": \"qty\"}}]}",
        "{\"answer\": \"qty 的平均值是 **2.9167** [1]。\", \"followups\": [], \"clarify\": null}"
      ]
    },
    {
