/**
 * Bundled sample dataset — richer than main's sample_data.csv by design:
 * 8 columns (temporal + 3 nominal + 4 numeric) × ~50 rows of e-commerce
 * sales with an upward trend, periodic promo spikes and a profit-margin
 * relation, so every chart family / panel has something to show.
 * Generated by a seeded LCG → identical data on every launch.
 */
const SAMPLE_NAME: string = '销售示例 2025Q1';

const SAMPLE_REGIONS: string[] = ['华东', '华南', '华北', '西南'];
const SAMPLE_CATEGORIES: string[] = ['数码', '家电', '服饰', '食品'];
const SAMPLE_CHANNELS: string[] = ['线上', '线下'];

function buildSampleCsv(): string {
  const lines: string[] = [];
  lines.push('日期,地区,品类,渠道,销售额,订单数,利润,客单价');
  let seed = 42001;
  const rand = (): number => {
    seed = (seed * 9301 + 49297) % 233280;
    return seed / 233280;
  };
  const day = 86400000;
  let t = new Date('2025-01-01').getTime();
  const end = new Date('2025-04-10').getTime();
  let i = 0;
  while (t <= end) {
    const date = new Date(t).toISOString().substring(0, 10);
    const region = SAMPLE_REGIONS[i % SAMPLE_REGIONS.length];
    const cat = SAMPLE_CATEGORIES[(i * 3 + 1) % SAMPLE_CATEGORIES.length];
    const channel = SAMPLE_CHANNELS[i % SAMPLE_CHANNELS.length];
    const base = 8200 + i * 260;                       // 增长趋势
    const promo = (i % 11 === 5) ? 1.9 : 1;            // 周期大促尖峰
    const weekend = (i % 7 === 3 || i % 7 === 4) ? 1.15 : 1;
    const noise = 0.75 + rand() * 0.5;
    const sales = Math.round(base * promo * weekend * noise);
    const orders = Math.max(1, Math.round(sales / (95 + rand() * 110)));
    const profit = Math.round(sales * (0.10 + rand() * 0.18));
    const aov = orders > 0 ? Math.round(sales / orders) : 0;
    lines.push(date + ',' + region + ',' + cat + ',' + channel + ','
      + sales.toString() + ',' + orders.toString() + ',' + profit.toString() + ',' + aov.toString());
    t += day * 2;
    i++;
  }
  return lines.join('\n');
}

export class SampleData {
  static readonly NAME: string = SAMPLE_NAME;
  static readonly CSV_TEXT: string = buildSampleCsv();
}
