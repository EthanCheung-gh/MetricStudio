/** Lookup a translated string; falls back to the key itself when missing. */
export function t(lang: Language, key: string): string {
  const table: Record<string, string> = lang === Language.Zh ? zh : en;
  const v = table[key];
  return v !== undefined ? v : key;
}

/** Legacy inline helper: pick zh/en by language. */
export function l10n(lang: Language, zhText: string, enText: string): string {
  return lang === Language.Zh ? zhText : enText;
}
