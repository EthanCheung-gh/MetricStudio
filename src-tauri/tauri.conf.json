{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetricStudio",
  "version": "0.3.2",
  "identifier": "com.metricstudio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/build-sidecar-entry.js && pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "MetricStudio",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/python-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
