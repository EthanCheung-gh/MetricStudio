{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetricStudio",
  "version": "0.1.8",
  "identifier": "com.metricstudio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "./scripts/build-sidecar.sh && pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "MetricStudio",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "externalBin": [
      "binaries/python-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
